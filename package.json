{
  "//1": "Repository scripts live in scripts/ (@shotkit/scripts, its own pnpm",
  "//2": "project with its own lockfile), one directory per command group, and",
  "//3": "every alias below names exactly one file: `pnpm verify:serve` runs",
  "//4": "scripts/verify/serve.ts. Run `pnpm -C scripts install` once per checkout.",
  "//5": "There is deliberately no pnpm-workspace.yaml here: one at the root makes",
  "//6": "`pnpm install` inside apps/typescript/ and apps/benchmark install the",
  "//7": "workspace instead of that project, and both are installed standalone by",
  "//8": "CI. The path to a real workspace is in apps/docs/scripts-to-typescript.md.",
  "//9": "This file also keeps the TypeScript compiler from walking above the",
  "//10": "repository root when resolving package.json files, and makes it emit",
  "//11": "ES modules under the default module=\"NodeNext\" configuration in",
  "//12": "tools/typescript/tsconfig_base.json.",
  "name": "shotium-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "scripts:check": "pnpm -C scripts check:types",
    "scripts:test": "pnpm -C scripts test",

    "build:engine": "pnpm -C scripts exec tsx build/engine.ts",
    "build:errors": "pnpm -C scripts exec tsx build/errors.ts",
    "build:shards": "pnpm -C scripts exec tsx build/shards.ts",
    "build:node-sdk": "pnpm -C scripts exec tsx build/node-sdk.ts",
    "check:syntax": "pnpm -C scripts exec tsx build/check-syntax.ts",
    "missing-inputs": "pnpm -C scripts exec tsx build/missing-inputs.ts",
    "depfiles:prune": "pnpm -C scripts exec tsx build/prune-stale-depfiles.ts",
    "icu:repack": "pnpm -C scripts exec tsx build/icu-repack.ts",
    "size:report": "pnpm -C scripts exec tsx build/size-report.ts",

    "verify:serve": "pnpm -C scripts exec tsx verify/serve.ts",
    "verify:net": "pnpm -C scripts exec tsx verify/net.ts",
    "verify:demos": "pnpm -C scripts exec tsx verify/demos.ts",
    "verify:node": "pnpm -C scripts exec tsx verify/node.ts",
    "verify:node-entry": "pnpm -C scripts exec tsx verify/node-entry.ts",
    "verify:daemon": "pnpm -C scripts exec tsx verify/daemon.ts",
    "verify:daemon-protocol": "pnpm -C scripts exec tsx verify/daemon-protocol.ts",
    "verify:bilibili": "pnpm -C scripts exec tsx verify/bilibili.ts",
    "verify:charset": "pnpm -C scripts exec tsx verify/charset.ts",
    "verify:ffi": "pnpm -C scripts exec tsx verify/ffi.ts",
    "verify:delivery": "pnpm -C scripts exec tsx verify/delivery.ts",
    "render": "pnpm -C scripts exec tsx verify/render-regression.ts",
    "accept": "pnpm -C scripts exec tsx verify/accept.ts",
    "pixel-diff": "pnpm -C scripts exec tsx verify/pixel-diff.ts",
    "diff-report": "pnpm -C scripts exec tsx verify/diff-report.ts",
    "bilibili:capture": "pnpm -C scripts exec tsx verify/bilibili-capture.ts",

    "ci:await-shards": "pnpm -C scripts exec tsx ci/await-shards.ts",
    "ci:dispatch-engines": "pnpm -C scripts exec tsx ci/dispatch-engines.ts",
    "ci:select-shards": "pnpm -C scripts exec tsx ci/select-shards.ts",
    "ci:stamp-mtimes": "pnpm -C scripts exec tsx ci/stamp-mtimes.ts",

    "perf:compare": "pnpm -C scripts exec tsx perf/compare.ts",
    "perf:ci": "pnpm -C scripts exec tsx perf/ci.ts",
    "perf:images": "pnpm -C scripts exec tsx perf/images.ts",
    "perf:report": "pnpm -C scripts exec tsx perf/report.ts",
    "perf:node-entry": "pnpm -C scripts exec tsx perf/node-entry.ts",

    "package:platform": "pnpm -C scripts exec tsx package/platform.ts",
    "package:cli": "pnpm -C scripts exec tsx package/cli.ts",
    "package:checksums": "pnpm -C scripts exec tsx package/checksums.ts",
    "package:c-abi": "pnpm -C scripts exec tsx package/c-abi.ts",
    "package:examples": "pnpm -C scripts exec tsx package/examples.ts",

    "trim-tree": "pnpm -C scripts exec tsx tree/trim-tree.ts",
    "graph:export": "pnpm -C scripts exec tsx tree/trim-tree.ts export",
    "prune-deps": "pnpm -C scripts exec tsx tree/prune-deps.ts",
    "gen:idl": "pnpm -C scripts exec tsx tree/gen-idl.ts",
    "restore:includes": "pnpm -C scripts exec tsx tree/restore-includes.ts",
    "restore:includes-by-prefix": "pnpm -C scripts exec tsx tree/restore-includes-by-prefix.ts",
    "restore:gn-deps": "pnpm -C scripts exec tsx tree/restore-gn-deps.ts",
    "restore:upstream": "pnpm -C scripts exec tsx tree/restore-from-upstream.ts",
    "gn:missing-sources": "pnpm -C scripts exec tsx tree/gn-missing-sources.ts",
    "gn:undefined-vars": "pnpm -C scripts exec tsx tree/gn-undefined-vars.ts",
    "gn:dangling-imports": "pnpm -C scripts exec tsx tree/gn-dangling-imports.ts",
    "mojom:dangling-imports": "pnpm -C scripts exec tsx tree/mojom-dangling-imports.ts",
    "jumbo:collisions": "pnpm -C scripts exec tsx tree/jumbo-collision-scan.ts",
    "probe:platform": "pnpm -C scripts exec tsx tree/probe-platform-graph.ts",
    "upstream:sync": "pnpm -C scripts exec tsx tree/upstream-sync.ts",
    "bootstrap": "pnpm -C scripts exec tsx tree/bootstrap.ts",
    "deps-lock": "pnpm -C scripts exec tsx tree/deps-lock.ts",

    "docs:assets": "pnpm -C scripts exec tsx docs/assets.ts",
    "docs:demo": "pnpm -C scripts exec tsx docs/demo.ts",
    "demo:sync": "pnpm -C scripts exec tsx docs/sync-demo-card.ts",
    "skills:link": "pnpm -C scripts exec tsx docs/link-agent-skills.ts"
  }
}
