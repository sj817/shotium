// Extracted from trusted_type_policy.idl. TrustedTypePolicy itself is a script
// object -- its callbacks are JS functions -- and is cut, but core/dom/element
// is written in terms of the union it declared: Element::setAttribute() takes a
// V8TrustedType to distinguish a plain string from a vouched-for one.
typedef (TrustedHTML or TrustedScript or TrustedScriptURL) TrustedType;
