import("//third_party/blink/renderer/core/core.gni")
import("//third_party/blink/renderer/core/url_pattern/build.gni")

blink_core_sources("url_pattern") {
  if (use_shot_jumbo_build) {
    # Reopens namespace blink::url_pattern, so unqualified lookup in later
    # sources of the same translation unit resolves differently.
    shot_jumbo_excluded_sources = [ "url_pattern_dummy_url_canon.cc" ]
  }

  sources = blink_core_sources_url_pattern

  public_deps = [
    "//components/url_pattern",
    "//third_party/blink/renderer/platform",
    "//third_party/liburlpattern",
  ]

  deps = [ "//third_party/abseil-cpp:absl" ]
}
# The blink_fuzzer_test("url_pattern_fuzzer") target was here, along with the
# blink_fuzzer_test.gni import it needed. The fuzzers are cut.
