// Extracted from navigate_event_init.idl. The Navigation API itself is cut;
// this enum is kept because core/timing's soft-navigation heuristics classify
// each navigation with V8NavigationType.
enum NavigationType {
  "reload",
  "push",
  "replace",
  "traverse"
};
