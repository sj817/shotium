#include "third_party/blink/public/common/permissions_policy/policy_helper_public.h"

#include "base/no_destructor.h"
#include "services/network/public/mojom/permissions_policy/permissions_policy_feature.mojom.h"

namespace blink {

// Public maps describe all declared policy names. Runtime gating is applied
// by the renderer policy helper.

const PermissionsPolicyNameToFeatureMap&
GetPermissionsPolicyNameToFeatureMap() {
  static const base::NoDestructor<PermissionsPolicyNameToFeatureMap>
      default_feature_name_map({
    {% for feature in permissions_policy_features %}
    {"{{feature.permissions_policy_name}}",
        network::mojom::PermissionsPolicyFeature::k{{feature.name}}},
    {% endfor %}
  });

  return *default_feature_name_map;
}

const PermissionsPolicyFeatureToNameMap&
GetPermissionsPolicyFeatureToNameMap() {
  static const base::NoDestructor<PermissionsPolicyFeatureToNameMap>
      default_feature_to_name_map({
    {% for feature in permissions_policy_features %}
    {network::mojom::PermissionsPolicyFeature::k{{feature.name}},
        "{{feature.permissions_policy_name}}"},
    {% endfor %}
  });
  return *default_feature_to_name_map;
}

}  // namespace blink
