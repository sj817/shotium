action("protocol_compatibility_check") {
  script = _inspector_protocol_dir + "/check_protocol_compatibility.py"

  # v8_inspector_js_protocol was declared by //v8/gni/v8.gni: the JS domains of
  # the protocol are gone with V8, leaving only the browser protocol.
  #
  # Dropping js_protocol.pdl leaves the browser domains referring to Runtime
  # types that nothing declares any more -- DOM.resolveNode's
  # Runtime.RemoteObject, Log's Runtime.StackTrace, Network's Runtime.ScriptId.
  # v8/ was a git submodule, so js_protocol.pdl cannot be recovered from this
  # repository even as a data file.
  #
  # expected_errors.json is the script's own mechanism for accepted
  # incompatibilities, and each of those types is listed there individually
  # rather than the check being disabled: everything the check is actually for
  # -- catching an unintended change to a domain that still exists -- keeps
  # working.
  inputs = [
             "browser_protocol.pdl",
             "browser_protocol-1.3.json",
             "expected_errors.json",
           ] + domains
  _stamp = "$_protocol_out_dir/browser_protocol.stamp"
  outputs = [ _stamp ]

  args = [
    "--stamp",
    rebase_path(_stamp, root_build_dir),
    "--expected_errors",
    rebase_path("expected_errors.json", root_build_dir),
    rebase_path("browser_protocol.pdl", root_build_dir),
  ]
}

action("protocol_version") {
  deps = [ ":protocol_compatibility_check" ]
  script = _inspector_protocol_dir + "/concatenate_protocols.py"

  inputs = [
             "$_inspector_protocol_dir/pdl.py",
             "browser_protocol.pdl",
           ] + domains
  output_file = "$_protocol_out_dir/protocol.json"
  outputs = [ output_file ]

  args = [
    rebase_path("browser_protocol.pdl", root_build_dir),
    rebase_path(output_file, root_build_dir),
  ]
}
