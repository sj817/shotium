  public_deps = [
    ":impl",
    ":ipcz_header",
    ":util",
    "//base",
  ]
  public_configs = [ ":ipcz_include_dir" ]
}

config("ipcz_include_dir") {
  include_dirs = [ "${ipcz_include_root}" ]
}

config("ipcz_include_src_dir") {
  include_dirs = [
    "${ipcz_src_root}",
    get_path_info("${ipcz_src_root}/", "gen_dir"),
  ]
}
