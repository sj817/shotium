import("//build_overrides/ipcz.gni")

source_set("ipcz_header") {
  visibility = [ ":*" ]
  public = [ "../include/ipcz/ipcz.h" ]
  public_configs = [ ":ipcz_include_dir" ]
}

source_set("ipcz") {
  public = [ "api.h" ]
  sources = [ "api.cc" ]
  deps = [
    ":ipcz_sources",
    "//third_party/abseil-cpp:absl",
  ]
  public_deps = [
    ":ipcz_header",
    "//base",
  ]
  public_configs = [ ":ipcz_include_dir" ]
  configs += [ ":ipcz_include_src_dir" ]

  # ChromeOS profiling data indicates that ipcz consumes 1.5% of Chrome's
  # cycles on that platform; per go/cr-os, it shouldn't be optimized for
  # size on that platform.
  if (is_chromeos) {
    configs -= [ "//build/config/compiler:default_optimization" ]
    configs += [ "//build/config/compiler:optimize_speed" ]
  }
}

source_set("util") {
  visibility = [ ":*" ]

  public = [
    "util/log.h",
    "util/multi_mutex_lock.h",
    "util/ref_counted.h",
    "util/strong_alias.h",
    "util/unique_ptr_comparator.h",
    "util/unsafe_buffers.h",
  ]

  sources = [ "util/ref_counted.cc" ]

  deps = [
    "//base",
    "//third_party/abseil-cpp:absl",
  ]
  configs += [ ":ipcz_include_src_dir" ]
}

