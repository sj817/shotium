config("warnings") {
  cflags = [ "-Wno-shadow" ]
}

component("liburlpattern") {
  defines = [ "IS_LIBURLPATTERN_IMPL" ]
  public_deps = [
    "//base",
    "//third_party/abseil-cpp:absl",
    "//third_party/icu",
  ]

  configs += [ ":warnings" ]

  # Note, also update the local modifications in README.chromium.
  sources = [
    "constructor_string_parser.cc",
    "constructor_string_parser.h",
    "options.h",
    "parse.cc",
    "parse.h",
    "part.cc",
    "part.h",
    "pattern.cc",
    "pattern.h",
    "tokenize.cc",
    "tokenize.h",
    "utils.cc",
    "utils.h",
  ]
}
