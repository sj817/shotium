// Values match net::EffectiveConnectionType; LAST is not a valid value.
enum EffectiveConnectionType {
  kUnknown = 0,
  kOffline = 1,
  kSlow2G = 2,
  k2G = 3,
  k3G = 4,
  k4G = 5,
};
