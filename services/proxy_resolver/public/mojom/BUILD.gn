import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  generate_java = true
  sources = [ "proxy_resolver.mojom" ]
  deps = [
    "//services/network/public/mojom:mojom_ip_address",
    "//services/network/public/mojom:mojom_network_anonymization_key",
    "//services/network/public/mojom:mojom_network_param",
    "//services/network/public/mojom:mojom_proxy_config",
    "//url/mojom:url_mojom_gurl",
  ]
  public_deps = [ "//sandbox/policy/mojom" ]

  if (!is_ios) {
    export_class_attribute_blink = "BLINK_PLATFORM_EXPORT"
    export_define_blink = "BLINK_PLATFORM_IMPLEMENTATION=1"
    export_header_blink = "third_party/blink/public/platform/web_common.h"
  }

  cpp_typemaps = [
    {
      types = [
        {
          mojom = "proxy_resolver.mojom.HostResolveOperation"
          cpp = "::net::ProxyResolveDnsOperation"
        },

        {
          mojom = "proxy_resolver.mojom.ProxyInfo"
          cpp = "::net::ProxyInfo"
        },
      ]
      traits_headers = [
        "//services/proxy_resolver/public/cpp/mojo_host_mojom_traits.h",
        "//services/proxy_resolver/public/cpp/proxy_resolver_mojom_traits.h",
      ]
      traits_public_deps = [
        "//services/proxy_resolver/public/cpp:proxy_resolver_mojom_support",
      ]
    },
  ]

  # //services/proxy_resolver_win and //services/proxy_resolver_mac, the
  # platform PAC resolvers, are deleted along with //services/proxy_resolver's
  # own implementation. Only the public interface surface is kept, because
  # network.mojom.ProxyLookupClient carries a net::ProxyInfo across -- proxy
  # *lookup* results, which have nothing to do with running a PAC script.
  #
  # The Windows typemap stays with it: services/network/windows_system_proxy_
  # resolver_mojo.cc converts between net::WinHttpStatus and the mojom enum, so
  # the two must remain the same type. Its traits files are the only part of
  # proxy_resolver_win that is restored.
  if (is_win) {
    cpp_typemaps += [
      {
        types = [
          {
            mojom = "proxy_resolver.mojom.WinHttpStatus"
            cpp = "::net::WinHttpStatus"
          },
        ]
        traits_headers = [ "//services/proxy_resolver_win/public/cpp/proxy_resolver_win_mojom_traits.h" ]
        traits_sources = [ "//services/proxy_resolver_win/public/cpp/proxy_resolver_win_mojom_traits.cc" ]
      },
    ]
  }

  # The is_mac equivalent for MacProxyStatus is deliberately not restored: it is
  # never evaluated on this platform, and leaving a path into a directory that
  # does not exist is the kind of latent trap that only fires for whoever tries
  # to build for Mac later.
}
