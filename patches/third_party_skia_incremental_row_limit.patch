@@ -525,6 +525,18 @@ public:
         return this->onIncrementalDecode(rowsDecoded);
     }

+    /**
+     *  Ask incrementalDecode() to return kIncompleteInput once it has written
+     *  `rows` more complete rows, whether or not the input has more, so that a
+     *  client which only keeps a window of the destination backed by memory
+     *  can consume those rows and call again. 0, the default, is no limit.
+     *
+     *  Honoured by codecs that write non-interlaced rows top to bottom in
+     *  order (the PNG codec); others ignore it and behave as before.
+     */
+    void setIncrementalRowLimit(int rows) { fIncrementalRowLimit = rows; }
+    int incrementalRowLimit() const { return fIncrementalRowLimit; }
+
     /**
      * The remaining functions revolve around decoding scanlines.
      */
@@ -1016,6 +1028,9 @@ private:

     bool fStartedIncrementalDecode = false;

+    // See setIncrementalRowLimit().
+    int fIncrementalRowLimit = 0;
+
     // Allows SkAndroidCodec to call handleFrameIndex (potentially decoding a prior frame and
     // clearing to transparent) without SkCodec itself calling it, too.
     bool fUsingCallbackForHandleFrameIndex = false;
