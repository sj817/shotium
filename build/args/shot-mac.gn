# GN args template for //shot:shot on macOS.
#
#   echo 'import("//build/args/shot-mac.gn")' > out/Shot/args.gn
#   gn gen out/Shot
#
# Everything platform-neutral is in shot.gn. This file is the three things
# that follow from building against a public runner's Xcode rather than the
# hermetic one Chromium's own bots fetch.

import("//build/args/shot.gn")

# The macOS arm64 runner has three cores and 7 GB; three 32-file Blink units
# at 2.2 GB each do not fit. 16 keeps the per-unit peak near 2 GB.
shot_jumbo_file_merge_limit = 16

# The runner's Xcode, because the hermetic one comes from an internal CIPD
# path this checkout cannot reach. build_overrides/build.gni would infer the
# same answer by asking should_use_hermetic_xcode.py whether that copy is
# present; saying it outright means the build does not depend on the
# inference. mac_sdk.gni's assert against system Xcode is gated on
# is_chrome_branded, which is false here.
use_system_xcode = true

# Clang modules, off, and this is a consequence of the line above rather than
# a preference. use_autogenerated_modules is !(is_apple && use_system_xcode),
# so system Xcode selects the hand-written modulemap path instead -- and those
# are prepared per Xcode version bucket by build/modules/modularize.py, run by
# Chromium's bots against the Xcode they pin. A public runner's Xcode is
# whatever GitHub installed.
#
# What that produced was gn failing at the very last check, after the whole
# dependency graph had resolved:
#
#   ERROR Input to targets not generated by a dependency.
#   The file:
#     //out/Shot/sdk/xcode_links/MacOSX15.5.sdk/usr/include/DarwinFoundation1.modulemap
#   is listed as an input or source for the targets:
#     //build/modules:system_modulemap
#
# //build/modules declares an action whose outputs are the SDK's include
# directory enumerated at gn time, and those modulemaps are written into that
# directory later, so nothing in the graph claims to produce them.
#
# Both args are needed and they do different things. use_clang_modules stops
# libc++ asking for //build/modules:system at all;
# use_unified_system_module stops build/modules/BUILD.gn from defining
# system_modulemap in the first place, which is what the error is actually
# about -- gn generates rules for every target a loaded BUILD.gn defines,
# reached or not.
#
# enable_strict_deps is false by default, so the assert in
# build/config/c++/c++.gni that strict deps requires unified modules does not
# fire.
use_clang_modules = false
use_unified_system_module = false
