# GN args template for //shot:shot on Linux.
#
#   echo 'import("//build/args/shot-linux.gn")' > out/Shot/args.gn
#   gn gen out/Shot
#
# Everything platform-neutral is in shot.gn; this file is only the two things
# that are wrong to state anywhere else, because on Windows they are not merely
# unnecessary but an error.

import("//build/args/shot.gn")

# Ozone, headless. Linux Chromium has no non-Ozone path any more -- files like
# ui/platform_window/common/BUILD.gn open with assert(use_ozone) -- so
# use_ozone = false is not a configuration upstream supports, and reaching it
# would mean patching those asserts out. Headless is upstream's own answer to
# "render without a display server", which is exactly what shot is, so it is
# the platform to select rather than X11 or Wayland.
#
# ozone_auto_platforms = false is what makes that a choice instead of an
# addition: left on, it turns X11 and Wayland on as well and drags in
# //ui/gfx/x, //ui/ozone/platform/wayland and the protocol bindings under them.
# Neither is in this tree, and neither would ever be selected at run time.
#
# These three cannot live in shot.gn. build/config/ozone.gni asserts that
# use_ozone is on if any ozone_platform_* is, and use_ozone is false on
# Windows, so a shared file that set ozone_platform_headless would fail the
# Windows configure step outright.
ozone_auto_platforms = false
ozone_platform = "headless"
ozone_platform_headless = true

# D-Bus. use_dbus defaults to is_linux, and //components/dbus is not in this
# tree: it is the desktop session bus -- power management, notifications,
# global media keys -- and shot renders one document with no session to talk
# to. Turning the arg off is upstream's switch for that; the alternative is
# vendoring a bus client that is never connected.
use_dbus = false

# PartitionAlloc-Everywhere, off, and only here.
#
# libshotium.so hides every symbol but the eight in shot_api.h -- see
# shot/shot_api.map, which explains why -- and PartitionAlloc's allocator shim
# is one of the things that hides. That leaves the library replacing the
# process allocator for itself and for nobody else, which is not a smaller
# version of replacing it: it is two allocators in one process with no way to
# tell their pointers apart. The first render found the seam:
#
#   #0  partition_alloc::PartitionRoot::FreeInUnknownRoot<...>(void*)
#   #1  _get_real_paths_from_prefix ()            <- fontconfig
#   #2  FcParseDir ()
#   ...
#   #11 SkFontConfigInterfaceDirect::matchFamilyName(...)
#   #13 blink::FontCache::MatchFamilyStyle(...)
#
# glibc allocated that string -- fontconfig asks realpath() for it -- and
# fontconfig, linked into the library, freed it through the library's own
# free(), which is PartitionAlloc's. In the executable the same code works
# because the shim's malloc is exported, so glibc's internal allocation went
# through PartitionAlloc too. PartitionAlloc's comment on the check that fires
# says what this is:
#
#   This is a crash to detect imperfect symbol interception.
#     -- partition_root_internal.h, GetSlotStartAndSlotSpanFromAddress
#
# It is imperfect by construction here, and there is no third state. Either the
# library exports malloc, and a host that loads it finds its own allocations
# going to shot's allocator for the life of the process, or it does not, and
# has no business claiming free(). ENABLE_SYSTEM_FREE_FALLBACK is upstream's
# answer to exactly this and is asserted to Android, where it is wired to the
# -Wl,--wrap symbols that make __real_free exist.
#
# This is in the Linux file rather than in shot.gn because Linux is the only
# one of the three that needs it. macOS forwards a foreign pointer to the
# system free() unconditionally -- MaybeHandleSystemDeallocation() is compiled
# in under PA_BUILDFLAG(IS_APPLE) -- and Windows links the DLL against the
# CRT's allocator rather than interposing on it. Both run the addon's checks
# green with the shim on, so turning it off there would cost them
# PartitionAlloc for nothing.
#
# What actually changes: malloc, free and the operator new family go to the
# system allocator. PartitionAlloc itself stays -- use_partition_alloc is
# untouched -- so blink's own partitions, the ones reached through
# WTF::Partitions and PartitionRoot directly rather than through malloc, are
# exactly what they were. Not measured yet on this tree, and the Linux numbers
# in bench/cross/RESULTS.md were taken with PA-E on.
use_allocator_shim = false
