# What is left of //components/services/storage/public/cpp.
#
# The upstream target also carried compression.{h,cc} (snappy/zstd for the
# storage service's on-disk blobs), inactivity_timer.{h,cc} and
# quota_client_callback_wrapper.{h,cc}. Nothing in this build references any of
# them, so they stay cut along with the storage service itself.
#
# These two are here because live code still names them:
#   quota_error_or.h  -- storage/browser/quota and file_system return
#                        QuotaErrorOr<T> from ~60 call sites.
#   big_io_buffer.h   -- content/browser/code_cache/generated_code_cache.cc
#                        wraps a mojo BigBuffer as a net::IOBuffer.
component("cpp") {
  output_name = "storage_service_public"

  public = [
    "big_io_buffer.h",
    "quota_error_or.h",
  ]

  sources = [ "big_io_buffer.cc" ]

  public_deps = [
    "//base",
    "//mojo/public/cpp/base",
    "//net",
  ]

  defines = [ "IS_STORAGE_SERVICE_PUBLIC_IMPL" ]
}
