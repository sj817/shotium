rust_static_library("browser_id_types") {
  crate_name = "content_browser_id_types"
  crate_root = "browsing_instance_id.rs"
  sources = [ crate_root ]
  allow_unsafe = true
  deps = [ "//third_party/rust/cxx/v1:lib" ]
}

rust_static_library("child_process_security_policy_impl") {
  # allow_unsafe is needed for FFI that underpins the `cxx` crate. While this
  # allows allow_unsafe for the entire crate, the Rust code also implements
  # finer-grained controls that allow unsafe code only for FFI code while
  # disallowing it by default for other code.
  allow_unsafe = true
  crate_root = "security/cpsp/lib.rs"
  sources = [
    "security/cpsp/child_process_security_policy_impl.rs",
    "security/cpsp/lib.rs",
    "security/cpsp/process_state.rs",
  ]
  cxx_bindings = [
    "security/cpsp/child_process_security_policy_impl.rs",
    "security/cpsp/process_state.rs",
  ]
  visibility = [ ":browser" ]
  configs += [ "//content:content_implementation" ]
  deps = [
    ":browser_id_types",
    "//base:feature",
    "//base:file_path",
    "//base:unguessable_token",
    "//content/common:common_id_types",
    "//storage/common:storage_common_rust",
    "//third_party/blink/public/common",
    "//third_party/rust/cxx/v1:lib",
    "//url:url_rust",
  ]
  if (is_component_build) {
    rustflags = [ "--cfg=component_build" ]
  }
}

