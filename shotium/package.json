{
  "name": "@shotkit/shotium",
  "version": "0.1.0",
  "description": "Static screenshots from a stripped Chromium: DOM, CSS, layout, paint, no JavaScript engine.",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "shotium": "cli.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "lib/",
    "native.js",
    "native.d.ts",
    "native/binding.cc",
    "native/binding.gyp",
    "native/stage_header.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@shotkit/shotium-linux-arm64": "0.1.0",
    "@shotkit/shotium-linux-x64": "0.1.0",
    "@shotkit/shotium-mac-arm64": "0.1.0",
    "@shotkit/shotium-mac-x64": "0.1.0",
    "@shotkit/shotium-win-arm64": "0.1.0",
    "@shotkit/shotium-win-x64": "0.1.0"
  },
  "scripts": {
    "check:types": "tsc --noEmit --strict index.d.ts native.d.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "license": "BSD-3-Clause"
}
