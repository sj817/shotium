{
  "name": "@shotkit/benchmark-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vue-tsc -b && vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "vue": "3.5.21",
    "vue-i18n": "11.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@vue/tsconfig": "0.8.1",
    "typescript": "5.9.2",
    "vitepress": "1.6.4",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  }
}
