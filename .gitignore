# Editors, operating systems, tool caches.
*~
.*.sw?
*.bak
*.orig
*.pyc
__pycache__/
.DS_Store
Thumbs.db
.idea/
.vscode
.vscode-server
/.vs/
/.clangd/
/.clangd-index/
.cache
.mypy_cache
.ruff_cache
compile_commands.json
rust-project.json
/GEMINI.md

# Build directories. out/Shot is the engine's, everything else under out/ is
# an experiment; see CLAUDE.md.
/out*/
/.landmines
/.cipd
/cipd_cache/
/.shot-pgo/

# What gclient writes beside the DEPS checkouts. The checkouts themselves are
# hidden by the nested .gitignore files (third_party/.gitignore,
# build/.gitignore, buildtools/.gitignore).
**/*_is_first_class_gcs
**/*_hash
**/*_content_names
third_party/rust/target/

# shotium's dev-only tooling (tsdown, typescript, @types/node). The package
# itself has no runtime dependencies.
/shotium/node_modules

# What tsdown builds out of shotium/src. It is what npm publishes, and it is
# regenerated by `npm run build` from a checkout, so committing it would mean
# a second copy of every source file that only agrees with the first one until
# someone forgets to rebuild.
/shotium/dist

# The node addon is built against a shot library rather than by `npm install`,
# and ships inside the platform package for its architecture. Both are
# artifacts.
/shotium/native/build
/shotium/prebuilds

# Where the platform packager assembles the six @shotkit/shotium-<os>-<arch>
# packages, and where `npm pack` leaves their tarballs. Every byte in there
# came out of a build directory.
/dist

# shot/testdata/out is where the check suites write their images. Only the
# oracle is an input -- a capture from an unstripped Chromium of the same
# revision, see tools/shot/accept.ps1 -- and everything beside it is whatever
# the last run happened to produce. Several of those were committed once and
# then showed up as a dirty tree after every check run.
/shot/testdata/out/*
!/shot/testdata/out/oracle.png

# The TypeScript benchmark keeps browsers and high-frequency evidence local.
# Only compact results copied into /benchmark-results are committed.
/apps/benchmark/node_modules
/apps/benchmark/out*
node_modules
apps/demo/faruzan.png

# The sandbox that the docs recording scripts rebuild from docs/demo before
# recording: a copy of the demo sources plus a real
# `npm install @shotkit/shotium`. Only what lands in docs/assets is kept.
/docs/.demo-run
/docs/.demo-terminal.gif

# Coding-agent files. CLAUDE.md, AGENTS.md and .claude/skills are the checked-in
# instructions. .agents/skills holds the links `pnpm skills:link`
# (scripts/link-agent-skills.ts) makes for agents that look there;
# CLAUDE.local.md and settings.local.json are per-machine.
/.agents/skills
/CLAUDE.local.md
/.claude/settings.local.json
