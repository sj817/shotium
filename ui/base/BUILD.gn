}

if (is_win || is_mac || is_linux || is_chromeos) {
  static_library("pixel_diff_test_support") {
    testonly = true
    sources = [
      "test/skia_gold_matching_algorithm.cc",
      "test/skia_gold_matching_algorithm.h",
      "test/skia_gold_pixel_diff.cc",
      "test/skia_gold_pixel_diff.h",
    ]
    deps = [
      "//base",
      "//base/test:test_config",
      "//testing/gtest",
      "//ui/gfx",
    ]

    if (!is_fuchsia) {
      data_deps = [ ":goldctl" ]
    }

    # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
    # enable the diagnostic by removing this line.
    configs += [ "//build/config/compiler:no_exit_time_destructors" ]
  }
}

if (use_blink) {
  group("goldctl") {
    data = []

    # Because this links to a CIPD dependency, which is a symlink on Unix
    # platforms, refer to the actual executable rather than the whole directory;
    # copying the whole directory doesn't work, at least with "mb.py zip".
    if (is_win) {
      data += [ "//tools/skia_goldctl/win/goldctl.exe" ]
    } else if (is_mac) {
      data += []
    } else {
      data += []
    }
  }
}

if (is_android) {
  java_cpp_features("java_features_srcjar") {
    # External code should depend on ":ui_base_features_java" instead.
    visibility = [ ":*" ]
    sources = [ "//ui/base/ui_base_features.cc" ]
    class_name = "org.chromium.ui.base.UiBaseFeatures"
  }
  android_library("ui_base_features_java") {
    # Right now, this only includes the Java features. But if we need more Java
    # files, they should be added here as necessary.
    srcjar_deps = [ ":java_features_srcjar" ]
  }

  java_cpp_enum("ui_base_types_srcjar") {
    sources = [ "ui_base_types.h" ]
  }

  android_library("ui_base_types_java") {
    srcjar_deps = [ ":ui_base_types_srcjar" ]
    deps = [ "//third_party/androidx:androidx_annotation_annotation_java" ]
  }
}

