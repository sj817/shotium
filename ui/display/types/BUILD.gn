component("types") {
  output_name = "display_types"
  sources = [
    "display_config.cc",
    "display_config.h",
    "display_constants.cc",
    "display_constants.h",
    "display_geometry.h",
    "display_mode.cc",
    "display_mode.h",
    "display_snapshot.cc",
    "display_snapshot.h",
    "display_types_export.h",
  ]

  defines = [ "DISPLAY_TYPES_IMPLEMENTATION" ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]

  deps = [
    "//base",
    "//components/viz/common/resources:shared_image_format",
    "//skia",
    "//skia:skcms",
    "//ui/gfx:buffer_types",
    "//ui/gfx:color_space",
    "//ui/gfx/geometry",
  ]
}
